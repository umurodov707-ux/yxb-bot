# Telegram bot tokeni (@BotFather)
BOT_TOKEN=123456:ABC-DEF
# Super Admin telegram_id lari (vergul bilan)
ADMIN_IDS=111111111,222222222
# Mini App ochiladigan HTTPS manzil (masalan https://yxb.example.uz)
WEBAPP_URL=https://yxb.example.uz
# PostgreSQL (prod). Lokal sinov uchun: sqlite+aiosqlite:///./yxb.db
DATABASE_URL=postgresql+asyncpg://yxb:yxb_password@localhost:5432/yxb
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
# Faqat lokal sinov uchun! Telegram'siz X-Dev-Tg-Id header orqali kirish
DEV_MODE=false
